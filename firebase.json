{
 "functions":[{
  "source":"functions",
  "codebase":"menuz",
  "runtime":"nodejs22",
  "ignore":["node_modules",".git","*.log","index.ts",".env.example"],
  "predeploy":["npm run build:functions"]
 }],
 "hosting":{
  "public":"dist/menuz/browser",
  "ignore":["firebase.json","**/.*","**/node_modules/**"],
  "predeploy":["npm run build"],
  "rewrites":[
   {"source":"/api/**","function":{"functionId":"api","region":"europe-west1"}},
   {"source":"**","destination":"/index.html"}
  ],
  "headers":[{"source":"**","headers":[{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"}]}]
 },
 "firestore":{"rules":"firestore.rules"},
 "storage":{"rules":"storage.rules"},
 "emulators":{"functions":{"port":5001},"hosting":{"port":5000},"ui":{"enabled":true}}
}
