PORT=3001
APP_MODE=demo
# Set APP_MODE=firebase to use your Firebase project locally.
# Keep the service-account JSON outside the repository.
# GOOGLE_APPLICATION_CREDENTIALS=C:/secure/service-account.json
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_API_KEY=your-web-api-key
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
# Exact bucket name, without gs:// or https://
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
